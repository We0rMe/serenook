{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serenook",
  "version": "0.9.1",
  "identifier": "com.juvenilescholar.launcher",
  "build": {
    "beforeDevCommand": null,
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": null,
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Serenook",
        "width": 920,
        "height": 640,
        "minWidth": 700,
        "minHeight": 540,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCNTQ3QkE3NTQzOTY5Q0MKUldUTWFUbFVwM3RVKzllcVBKSk5wYWV3SzBGVHFrenVBL0VJbXRhYzhCdDNtK01Odld5QnJrQnUK",
      "endpoints": [
        "https://github.com/We0rMe/serenook/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
